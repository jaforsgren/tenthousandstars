{
  "DispositionDescriptions": {
    "Aggressive": [
      "They expand through force alone. Every system taken by blood.",
      "No quarter given, none expected. Their fleets sweep without pause.",
      "They do not negotiate. They erase.",
      "Expansion is not a goal. It is an instinct.",
      "They measure success in ashes, not territory.",
      "Every border they touch becomes a warfront.",
      "They do not stop advancing. Only dying slows them.",
      "Peace is an unfamiliar concept to them.",
      "They do not hold grudges. They hold targets.",
      "Conflict defines them more than survival.",
      "They strike first, and rarely stop to think after.",
      "Their empire is built on momentum alone."
    ],
    "Strategic": [
      "Every move deliberate. Every fleet positioned with purpose.",
      "A methodical power. They will not overextend — but they will arrive.",
      "They trade time for certainty, and always profit.",
      "They do not rush. They arrive prepared.",
      "Every system has a purpose in their design.",
      "They see weakness as a resource to be exploited.",
      "Nothing they do is accidental.",
      "They win long before the first shot is fired.",
      "Their patience is structured, not passive.",
      "They bend the map to fit their intentions.",
      "Efficiency is valued over dominance.",
      "They adapt faster than their enemies can react."
    ],
    "Cautious": [
      "They move slowly, but patience has outlasted many who underestimated them.",
      "They watch, they wait, and strike only when certain of the outcome.",
      "They survive where others burn out.",
      "Their restraint is mistaken for weakness.",
      "They avoid fights they cannot finish.",
      "They prefer safety over ambition.",
      "They retreat often, but never collapse.",
      "They build slowly, but lose even slower.",
      "They rely on certainty over instinct.",
      "They fear overextension more than defeat.",
      "They wait for enemies to make mistakes.",
      "They do not forgive risk easily."
    ],
    "Dormant": [
      "They have not moved in some time. But their fleets are growing.",
      "Seemingly at rest. Do not mistake stillness for weakness.",
      "They have withdrawn, but not disappeared.",
      "Their silence stretches across entire sectors.",
      "They react only when disturbed.",
      "Time means little to them.",
      "They are conserving something. No one knows what.",
      "Their inactivity feels deliberate.",
      "They expand inward, not outward.",
      "They exist without urgency.",
      "They are still. The galaxy is not.",
      "Their awakening is always too late to stop."
    ]
  },
